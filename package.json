  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/xai": "^5.0.23",

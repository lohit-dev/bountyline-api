# Server
PORT=3000
API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bountyline

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_SLUG=bountyline
GITHUB_APP_ID=
# Paste the .pem on one line, with \n between lines
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The same app's OAuth credentials, used for "sign in with GitHub"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secrets you generate: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# PayPal (developer.paypal.com > Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# AI review
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-4-5

# Amounts offered by the checkbox picker, in USD
PICKER_AMOUNTS_USD=25,50,100,250
